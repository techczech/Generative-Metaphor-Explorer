                          "timestamp"
                        ],
                        "additionalProperties": false
                      },
                      "maxItems": 10000
                    },
                    "generatedImage": {
                      "type": "object",
                      "properties": {
                        "base64Data": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9+/]+={0,2}$",
                          "maxLength": 30000000
                        },
                        "mimeType": {
                          "enum": [
                            "image/png",
                            "image/jpeg",
                            "image/webp"
                          ]
                        },
                        "history": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "prompt": {
                                "type": "string"
                              },
                              "timestamp": {
                                "type": "number",
                                "minimum": 0
                              }
                            },
                            "required": [
                              "prompt",
                              "timestamp"
                            ],
                            "additionalProperties": false
                          },
                          "maxItems": 10000,
                          "minItems": 1
                        }
                      },
                      "required": [
                        "base64Data",
                        "mimeType",
                        "history"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "mappingSetIndex",
                    "consequences"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 10000
              },
              "comparisons": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "perspectiveIndices": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "maxItems": 10000
                    },
                    "aiSummary": {
                      "type": "string"
                    },
                    "userNotes": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "perspectiveIndices",
                    "aiSummary",
                    "userNotes",
                    "timestamp"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 10000
              },
              "timestamp": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "metaphor",
              "analysis",
              "exploredPerspectives",
              "timestamp"
            ],
            "additionalProperties": false
          },
          "maxProperties": 1000
        }
      },
      "required": [
        "format",
        "version",
        "analyses"
      ],
      "additionalProperties": false
