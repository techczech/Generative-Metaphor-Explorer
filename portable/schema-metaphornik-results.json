                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "icon": {
                          "type": "string"
                        },
                        "mappings": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
