                      "name": {
                        "type": "string"
                      },
                      "facts": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "text": {
                              "type": "string"
                            },
                            "custom": {
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "id",
                            "text"
                          ],
                          "additionalProperties": false
                        },
                        "maxItems": 10000
                      }
                    },
                    "required": [
                      "name",
                      "facts"
                    ],
                    "additionalProperties": false
                  },
