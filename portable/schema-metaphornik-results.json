{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metaphornik portable results version 1",
  "description": "Runtime validator additionally checks record keys match metaphor, unique fact IDs and perspective indices, valid mapping references, image base64 length and forbidden prototype keys.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "format": {
          "const": "metaphornik-results"
        },
        "version": {
          "const": 1
        },
