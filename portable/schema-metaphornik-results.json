                },
                "required": [
                  "sourceDomain",
                  "targetDomain",
                  "mappingSets"
                ],
                "additionalProperties": false
              },
              "exploredPerspectives": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "mappingSetIndex": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "consequences": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "maxItems": 10000
                    },
                    "generatedDocuments": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string"
                          },
                          "content": {
                            "type": "string"
                          },
                          "timestamp": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": [
